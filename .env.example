# Client-side environment variables (must be prefixed with VITE_)
# Set these in railway.app dashboard for the static site/client service.
VITE_WS_URL=wss://your-dropfall-server.up.railway.app
VITE_LEVEL_API_URL=https://your-dropfall-server.up.railway.app/api

# Server-side environment variables
# Set these in railway.app dashboard for the game server service.
PORT=3000
DROPFALL_HOST=0.0.0.0
# Comma-separated exact browser origins allowed to call the API or open sockets.
DROPFALL_ALLOWED_ORIGINS=https://play.dropfall.example
# Optional deletion/admin token. Publishing is temporarily public, but destructive
# level operations remain protected; never expose this value to players.
DROPFALL_EDITOR_TOKEN=replace-with-a-random-local-authoring-token
# Dev-only admin/editor pages are loopback-only unless explicitly enabled.
DROPFALL_ENABLE_DEV_TOOLS=0

# Standalone local authoring launcher (`npm run editor`).
EDITOR_PORT=3001
EDITOR_HOST=127.0.0.1
